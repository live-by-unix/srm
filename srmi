# BSD 3-Clause License

set -eu

# Version
SRM_VERSION="1.0.0"

# Exit codes
EXIT_SUCCESS=0
EXIT_ERROR=1
EXIT_USAGE=2

# Detect operating system
detect_platform() {
    case "$(uname -s)" in
        Darwin)
            echo "macos"
            ;;
        Linux)
            echo "linux"
            ;;
        CYGWIN*|MINGW*|MSYS*)
            echo "windows"
            ;;
        *)
            echo "unknown"
            ;;
    esac
}

# Print full help
print_help() {
    cat << EOF
srm (Safe RM) - Information

NAME
    srmi - Display information about srm (Safe RM)

SYNOPSIS
    srmi [OPTION]

DESCRIPTION
    srm is a cross-platform alternative to rm that moves files and directories
    to the native Trash or Recycle Bin instead of permanently deleting them.

    srmi displays information about srm, including help, version, usage,
    license, and platform compatibility.

OPTIONS
    --help      Display this help message
    --version   Display version information
    --usage     Display brief usage summary
    --license   Display license information

PLATFORMS
    macOS       Uses NSFileManager API for native Finder Trash integration
    Linux       Implements FreeDesktop.org Trash specification
    Windows     Uses Windows Shell IFileOperation API (srm.bat)

ENTRY POINTS
    POSIX:      srm (removal), srmi (information)
    Windows:    srm.bat (removal), srmi.bat (information)

IMPORTANT NOTE
    srm --help does NOT display help information. The removal commands treat
    --help and --version as ordinary filenames. Use srmi --help for documentation.

EXAMPLES
    srmi --help
    srmi --version
    srmi --usage
    srmi --license

INSTALLATION
    macOS/Linux:  ./scripts/install.sh
    Windows:      scripts\install.bat

DOCUMENTATION
    README.md        Overview and quick start
    INSTALL.md       Installation instructions
    USAGE.md         Detailed usage guide
    WINDOWS.md       Windows-specific documentation
    COMPATIBILITY.md Platform compatibility details
    docs/            Additional platform-specific documentation

REPOSITORY
    https://github.com/live-by-unix/srm

WEBSITE
    https://live-by-unix.github.io/srm

AUTHOR
    live-by-unix

COPYRIGHT
    Copyright (c) 2026 live-by-unix
    BSD 3-Clause License
EOF
}

# Print version
print_version() {
    printf '%s\n' "srm (Safe RM) version $SRM_VERSION"
    printf '%s\n' "Copyright (c) 2026 live-by-unix"
    printf '%s\n' "BSD 3-Clause License"
    printf '\n%s\n' "Platform: $(detect_platform)"
}

# Print brief usage
print_usage() {
    cat << EOF
Usage: srm [OPTION]... FILE...
Move files to the native Trash instead of permanently deleting them.

Common options:
  -f, --force         ignore nonexistent files and arguments
  -r, -R, --recursive  remove directories and their contents recursively
  -v, --verbose       explain what is being done
  --                  end of options

For information: srmi --help
For version:     srmi --version
EOF
}

