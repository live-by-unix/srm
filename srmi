}

# Main
main() {
    if [ $# -eq 0 ]; then
        print_help
        exit "$EXIT_SUCCESS"
    fi

    case "$1" in
        --help)
            print_help
            exit "$EXIT_SUCCESS"
            ;;
        --version)
            print_version
            exit "$EXIT_SUCCESS"
            ;;
        --usage)
            print_usage
            exit "$EXIT_SUCCESS"
            ;;
        --license)
            print_license
            exit "$EXIT_SUCCESS"
            ;;
        *)
            printf '%s\n' "srmi: invalid option '$1'" >&2
            printf '%s\n' "Try 'srmi --help' for more information." >&2
            exit "$EXIT_USAGE"
            ;;
    esac
}

# Run main
main "$@"
